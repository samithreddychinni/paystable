# paystable configuration (generated by: paystable init)
# local/dev defaults — edit before production use
# required

# CHANGE THIS — set the password to match your Postgres user
DATABASE_URL=postgres://paystable:CHANGE_ME@localhost:5432/paystable?sslmode=disable
GATEWAY=payu

# generated local secrets (do not commit .env)
WEBHOOK_SECRET=__WEBHOOK_SECRET__
MERCHANT_CALLBACK_SECRET=__MERCHANT_CALLBACK_SECRET__
ADMIN_API_KEY=__ADMIN_API_KEY__
SECRET_ENCRYPTION_KEY=__SECRET_ENCRYPTION_KEY__

# TODO: set from your PayU dashboard
GATEWAY_API_KEY=
PAYU_STATUS_URL=

# optional (defaults shown)
#PORT=8080
#STABILIZATION_N=3
#MAX_BACKOFF_S=160
#HOLD_MAX_TTL_S=900
#LOG_LEVEL=info
#DELIVERY_TIMEOUT_S=10
#DELIVERY_WORKER_CONCURRENCY=20
#DELIVERY_ALLOW_INSECURE_CALLBACK=false

# Razorpay: set GATEWAY=razorpay and enable auto-capture
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
#RAZORPAY_API_URL=https://api.razorpay.com/v1
