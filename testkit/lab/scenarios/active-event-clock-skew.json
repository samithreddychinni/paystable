{
  "name": "negative clock skew keeps an event claim active",
  "program": "expire-event-claim",
  "order_id": "order_clock_skew",
  "actions": [
    {"type": "deliver", "event_id": "event_clock_skew", "status": "captured"},
    {"type": "advance", "advance_seconds": 87000, "clock_skew_seconds": -1200},
    {"type": "deliver", "event_id": "event_clock_skew", "status": "captured"}
  ]
}
