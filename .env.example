#paystable configuration
#copy this file to .env and fill in your values

#required
# create the database first:
# CREATE USER paystable WITH PASSWORD 'change-this-password';
# CREATE DATABASE paystable OWNER paystable;
DATABASE_URL=postgres://paystable:change-this-password@localhost:5432/paystable?sslmode=disable
GATEWAY=payu
WEBHOOK_SECRET=your_payu_salt_here
GATEWAY_API_KEY=your_payu_merchant_key_here
PAYU_STATUS_URL=https://info.payu.in/merchant/postservice.php?form=2
MERCHANT_CALLBACK_SECRET=secret_for_signing_outbound_callbacks
ADMIN_API_KEY=secret_for_admin_endpoints
SECRET_ENCRYPTION_KEY=32_byte_base64_hex_or_raw_key

#optional (defaults shown)
#PORT=8080
#STABILIZATION_N=3
#MAX_BACKOFF_S=160
#HOLD_MAX_TTL_S=900
#LOG_LEVEL=info
#DELIVERY_TIMEOUT_S=10
#DELIVERY_WORKER_CONCURRENCY=20
#DELIVERY_ALLOW_INSECURE_CALLBACK=false

# Alerting (optional — if not set, alerts are logged only)
#SLACK_WEBHOOK_URL=
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_CHAT_ID=

# Razorpay: set GATEWAY=razorpay and enable auto-capture
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
#RAZORPAY_API_URL=https://api.razorpay.com/v1
